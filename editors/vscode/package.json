{
  "name": "runtree",
  "displayName": "runtree",
  "description": "Errors and warnings as you type, go to definition for includes, completion and documentation for runtree tree files",
  "version": "0.1.0",
  "publisher": "nagylzs",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/nagylzs/runtree"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "runtree",
    "yaml",
    "schema"
  ],
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "contributes": {
    "configuration": {
      "title": "runtree",
      "properties": {
        "runtree.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the runtree language server (runtree-lsp): errors and warnings of the tree files as you type, go to definition for includes."
        },
        "runtree.languageServer.path": {
          "type": "string",
          "default": "runtree-lsp",
          "description": "The runtree-lsp executable (a name on the PATH, or a path)."
        }
      }
    },
    "commands": [
      {
        "command": "runtree.restartLanguageServer",
        "title": "runtree: Restart the language server"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "*.rt.yaml",
          "*.rt.yml"
        ],
        "url": "./runtree.schema.json"
      }
    ],
    "configurationDefaults": {
      "yaml.customTags": [
        "!raw scalar"
      ]
    },
    "problemMatchers": [
      {
        "name": "runtree",
        "owner": "runtree",
        "source": "runtree",
        "severity": "error",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(\\S.*?):(\\d+)(?::(\\d+))?: (?:(warning): )?(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "cp ../../schema/runtree.schema.json ../../LICENSE .",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
